{
  "schema_version": "1.0",
  "prd_version": "7.18",
  "profile_id": "RETENTION_INFO_V1",
  "updated_date": "2026-10-12",
  "purpose": "先用反向观点挑战熟悉人物的根本评价，再以事实、因果、证据和后果持续兑现。",
  "basis": "2026-10-04重新审计中的完播率建议；2026-10-05用户授权纳入后续文稿与执行指令。；2026-10-12用户明确纠正为根本认知冲突优先，事实随后支撑。",
  "trial": {
    "status": "active_revocable",
    "duration_target_s": [
      25,
      30
    ],
    "reference_structure_is_mandatory": false,
    "stage_windows_are_actual_timecodes": false,
    "guaranteed_retention_improvement": false,
    "platform_standard": false,
    "adjustment": "按后续真实表现与用户反馈调整或撤销；不得为满足五段或秒数机械填充、伪造反方或省掉必要前因。"
  },
  "duration": {
    "existing_max_s": 40,
    "includes_intro_outro_and_pauses": true,
    "final_voice_rate_from_original": 1.25,
    "apply_rate_once": true,
    "estimate_before_audio_only": true,
    "do_not_shrink_by_extra_speedup": true
  },
  "reference_structure": [
    {
      "stage": "counter_claim",
      "suggested_window_s": [
        0,
        2
      ],
      "function": "主线首句挑战大众对熟悉人物最认定的评价；允许标题核心句作为首句，随后及时给事实。"
    },
    {
      "stage": "necessary_context",
      "suggested_window_s": [
        2,
        5
      ],
      "function": "交代理解此事不可缺的动机、关系或前因；不省略会改变责任判断的事实。"
    },
    {
      "stage": "first_evidence",
      "suggested_window_s": [
        5,
        12
      ],
      "function": "第一项可核验的具体行为或证据，必要古文随即译成短白话。"
    },
    {
      "stage": "new_discovery_or_counterargument",
      "suggested_window_s": [
        12,
        20
      ],
      "function": "提供标题未讲完的新发现、后果或责任边界；若有真正相关的最强反方，用必要事实回应，不编稻草人，也不强制两面平衡。"
    },
    {
      "stage": "payoff",
      "suggested_window_s": [
        20,
        28
      ],
      "function": "在证据基础上回应同一人物评价；可呼应开头，删无推进的同义空骂，不强要互动。"
    }
  ],
  "writing_rules": {
    "title_opening_and_ending_have_distinct_functions": false,
    "new_verified_information_beyond_title": true,
    "review_every_content_segment_for_information_gain": true,
    "information_gain_types": [
      "具体动作或事实",
      "必要因果或关系",
      "新证据及其含义",
      "后果或代价",
      "相关最强反方及事实回应",
      "改变责任判断的限定条件"
    ],
    "remove_repetition_test": "本句是否推进证据、关系、因果、观点或有证据后的收束？只删无推进的同义空骂；首句与标题相同、结尾呼应观点不自动判重复。",
    "connective_or_brief_explanation_allowed": true,
    "fixed_number_of_facts_or_twists": false,
    "counterargument_required_in_every_episode": false,
    "sharp_supported_judgment_allowed": true,
    "forbidden": [
      "以人物生平和固定欢迎语慢热开场",
      "正文反复换词重复同一指责",
      "用“更离谱的还在后面”代替真实信息",
      "虚构证据、引文、数字、反转或动机",
      "为制造争议删去改变责任判断的前因",
      "用无推进的重复判断凑时长或强行要求评论"
    ],
    "second_person_audience_address_default": false,
    "source_categories_must_remain_distinct": true,
    "voice_script_contains_only_narration": true,
    "core_title_may_be_opening": true,
    "evidence_based_ending_may_revisit_core_claim": true,
    "ironic_praise_required": false
  },
  "visual_execution": {
    "first_image_depicts_opening_action_conflict": false,
    "first_character_identity_clear_without_knowing_actor": true,
    "visual_change_follows_information_or_story_beat": true,
    "angle_changes_alone_count_as_new_information": false,
    "fixed_cut_interval_s": null,
    "fixed_image_count": null,
    "template_id": "RYP_STORY_MAIN_V3_2",
    "all_template_variants_required": false,
    "captions_and_template_geometry_unchanged": true,
    "no_extra_motion_music_or_sound_effects": true,
    "caption_profile_id": "STATIC_CAPTION_PAGES_V1",
    "static_caption_page_split_is_new_story_information": false,
    "same_art_may_be_reused_for_caption_pages": true,
    "first_image_depicts_character_and_key_evidence": true
  },
  "workflow": {
    "applies_to": "后续新写稿件、用户授权修改的稿件和相应生产指令；不自动重做已完成内容。",
    "locked_script_auto_rewrite": false,
    "production_instruction_includes_complete_approved_script": true,
    "production_instruction_names_profile_and_version": true,
    "draft_review_before_lock": "先核对大众评价、反向观点与论据是否对应，再查必要前因、信息推进、首尾呼应与自然口语。",
    "after_lock": "按锁定稿完善画面及必要内部说明；发现内容问题报告具体句段，不静默改词或添新口播。",
    "internal_record": "沿用本地brief、storyboard的visual_task/change_from_previous及production_log；不另建复杂评分或要求用户逐镜确认。",
    "user_mapping_columns": [
      "插图编号",
      "对应口播"
    ],
    "user_mapping_extra_columns_allowed": false,
    "real_timestamps_only_after_final_voice": true,
    "operations_table_or_automation_change_required": false,
    "program_editorial_spec": "spec/program_editorial.json",
    "operations_trial_boundary": "文案规则本身不自动修改运营；用户授权的栏目／验证任务按PRD 20.5和现行运营工作流执行。"
  },
  "rule_revision": "1.2",
  "revision_scope": "editorial_direction_and_writing_only; preserve_approved_production_assets",
  "topic_and_promise_review": {
    "applies_to": [
      "new_unlocked_drafts",
      "explicitly_authorized_rewrites"
    ],
    "selection_questions": [
      "strong_recognizable_popular_belief",
      "direct_counter_claim_about_same_evaluation",
      "concrete_evidence_supporting_claim",
      "understandable_context_and_further_evidence"
    ],
    "person_recognition_or_death_count_alone_is_not_sufficient": true,
    "record_in_existing_local_brief": [
      "opening_promise",
      "early_fact_payoff",
      "later_new_fact",
      "popular_belief",
      "belief_basis",
      "counter_claim",
      "evidence_for_claim",
      "natural_language_review"
    ],
    "fixed_number_of_twists_or_discoveries": null,
    "apply_program_specific_structure": true,
    "cold_names_first_mention": "state_name_and_necessary_role_or_relationship; do_not_replace_key_name_with_vague_big_person",
    "necessary_context_and_source_nature_must_survive_compression": true,
    "unknown_historical_motives_or_unverified_dialogue_as_fact": false,
    "locked_or_scheduled_scripts_auto_rewrite": false
  },
  "internal_delivery_review": {
    "inspect_actual_rendered_first_png": [
      "recognizable_evaluated_character_and_key_evidence",
      "image_supports_counter_claim_or_following_fact",
      "theme_caption_source_readable_at_phone_scale",
      "no_unrelated_simultaneous_reading_tasks"
    ],
    "inspect_story_beats": "each main beat adds action_choice_evidence_or_consequence; subtitle_pages_and_repeated_hospitality_or_judgments_are_not_new_story_facts",
    "voice_review": "inspect_actual_final_voice_only_when_available; estimates_are_not_measured_two_second_playback_or_timing",
    "record": "existing_local_production_log; include actual_paths_evidence_checked_and_missing_items",
    "new_user_confirmation": false,
    "extra_user_csv_columns": false,
    "performance_threshold_or_predicted_score_as_production_gate": false
  },
  "editorial_profile_id": "EDITORIAL_COGNITION_V1",
  "editorial_spec": "spec/editorial_cognition.md"
}
