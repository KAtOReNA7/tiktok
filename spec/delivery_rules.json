{
  "prd_version": "7.7",
  "root_relative": "交付",
  "topic_directory": "{topic_id}_{topic_short_name}",
  "part_directory": "{part_number:02d}_第{part_number:02d}集_{part_short_title}",
  "file_pattern": "{topic_id}_P{part_number:02d}_{shot_id_if_applicable}_{purpose}_v{revision:02d}.{ext}",
  "compress": false,
  "shared_directory": "00_共享素材",
  "old_versions_directory": "90_历史版本",
  "manifest_name": "00_交付清单.md",
  "required_per_part": [
    "口播稿_含开头正文结尾",
    "封面.png",
    "发布文案.txt_含一句话简介",
    "黑底字幕.mp4_收到最终人声后",
    "字幕放置说明.txt",
    "素材映射.csv",
    "实际漫画与套版素材"
  ],
  "cancelled": [
    "音效",
    "配乐",
    "轻动效",
    "音效配乐动效建议",
    "压缩包"
  ],
  "caption_spec": "spec/caption_style.json",
  "max_duration_s": 40,
  "intro_mode_default": "per_part",
  "intro_mode_allowed": [
    "per_part",
    "shared_topic"
  ],
  "outro_mode": "per_part",
  "scene_map": {
    "template": "episode/scene_map.csv",
    "columns": [
      "插图编号",
      "对应口播"
    ],
    "column_count": 2,
    "row_order": "口播顺序",
    "narration_text": "完整定稿原文，不用摘要、省略号或指代",
    "image_number_matches_filename": true,
    "extra_columns_allowed": false,
    "empty_placeholder_columns_allowed": false,
    "append_timing_after_voice": false,
    "subtitle_timing_location": "字幕制作文件及字幕放置说明，独立于素材映射",
    "updated_date": "2026-09-18"
  },
  "repository": "https://github.com/KAtOReNA7/tiktok",
  "branch": "main",
  "handoff_mode": "select_first_setup_or_local_continue",
  "execution": {
    "modes": [
      "first_setup",
      "local_continue",
      "rules_update"
    ],
    "default_when_local_files_available": "local_continue",
    "explicit_user_mode_takes_priority": true,
    "new_session_requires_remote_sync": false,
    "new_topic_or_part_requires_remote_sync": false,
    "local_continue_github_access": false,
    "local_continue_requires_latest_remote": false,
    "local_continue_requires_full_handoff_validation": false,
    "missing_local_file_auto_initializes": false,
    "remote_sync_triggers": [
      "first_setup_when_not_initialized",
      "explicit_rules_sync_or_update"
    ],
    "mode_record_location": "existing_local_production_log_or_execution_index",
    "instruction_files_separate_by_mode": true,
    "instruction_files_local_only": true,
    "instruction_file_delivery": {
      "default_extension": ".txt",
      "allowed_extensions": [
        ".txt",
        ".md"
      ],
      "actual_downloadable_file_required": true,
      "chat_text_is_optional_preview_only": true,
      "self_contained_episode_task": true,
      "verify_before_delivery": [
        "execution_mode",
        "approved_script_complete",
        "all_sections",
        "file_end_marker"
      ],
      "end_marker_is_narration": false
    }
  },
  "local_workspace_default": "../tiktok-local",
  "repository_scope": [
    "PRD与项目方向",
    "接续说明与必要状态摘要",
    "通用spec与空白episode模板",
    "固定assets与refs",
    "校验工具与清单"
  ],
  "local_only_content": [
    "选题调研",
    "论点与口播含定稿",
    "来源表",
    "分镜与素材映射",
    "单集制作审片记录",
    "生成素材配音字幕成片工程",
    "旧生产归档"
  ],
  "upload_episode_content_on_approval": false,
  "commit_for_every_content_delivery": false,
  "publishing_title": {
    "default_max_characters": 20,
    "punctuation_counts": true,
    "project_rule_not_universal_platform_limit": true,
    "locked_over_limit_title": "report_length_and_suggest_without_silent_rewrite",
    "cover_layout_checked_separately": true
  },
  "operations": {
    "independent_from_production": true,
    "handoff": "spec/operations_handoff.md",
    "reuse_existing_authorized_task": true,
    "default_start_time": "13:00",
    "timezone": "Asia/Shanghai",
    "production_requires_operations_run": false,
    "daily_operations_requires_github": false,
    "authorized_feishu_content": [
      "选题元数据与来源核验边界",
      "作品运营指标",
      "评论分析"
    ],
    "upload_complete_production_archive": false,
    "dynamic_data_in_git": false,
    "workflow_file": "三只不服_运营工作流.md",
    "rating_rules_file": "三只不服_运营评级规则.md",
    "runtime_state_file": "三只不服_定时运行状态.json",
    "character_first_selection": "trial_revocable_by_user",
    "selection_rule_reference": "PRD_V7.md section 2.4"
  },
  "character_identity_spec": "spec/character_identity.json",
  "character_acceptance": {
    "user_approval_required": false,
    "continue_after_internal_identity_pass": true,
    "all_hosts_original_chibi": true,
    "applies_to": [
      "scene",
      "cover",
      "edge_overlay",
      "repair"
    ],
    "actual_refs_for_each_visible_host": true,
    "visual_check_each_visible_host": true,
    "rejected_status": "REJECTED_IDENTITY",
    "unchecked_status": "UNVERIFIED_IDENTITY",
    "rejected_or_unverified_as_ready": false,
    "identity_qa_location": "existing_local_production_log",
    "mapping_columns_unchanged": true
  }
}
